# Copy to .env and fill in
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/aurea
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3002
# Optional - when unset, checkout runs in DEV mode (no real charge)
STRIPE_SECRET_KEY=
# Optional SMTP for real emails (dev logs to console instead)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hello@aurea.example
